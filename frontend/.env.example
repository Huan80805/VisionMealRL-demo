# Browser-safe API base. Leave unset to use Vite's /agent-api proxy.
# VITE_AGENT_API_BASE=http://127.0.0.1:8000
# VITE_AGENT_API_BASE=https://your-public-space.hf.space

# Dev-server-only private Hugging Face backend proxy target.
# These are read by vite.config.ts and are not exposed to browser code.
HF_SPACE_URL=https://your-private-space.hf.space
HF_TOKEN=hf_your_private_space_token
